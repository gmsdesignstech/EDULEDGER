generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { SUPER_ADMIN SCHOOL_ADMIN TEACHER STUDENT PARENT ACCOUNTANT LIBRARIAN STAFF }
enum Status { ACTIVE INACTIVE PENDING APPROVED REJECTED WAITLISTED }
enum PaymentStatus { CREATED PAID FAILED REFUNDED }
enum AttendanceStatus { PRESENT ABSENT LATE LEAVE }
model Institution { id String @id @default(cuid()); name String; type String; status String @default("Active"); createdAt DateTime @default(now()); users User[]; classes Class[]; students Student[]; teachers Teacher[]; fees Fee[]; subscriptions Subscription[]; institutionSettings InstitutionSetting?; academicYears AcademicYear[]; configuredClasses InstitutionClass[]; schoolAssets SchoolAsset[] }
model User { id String @id @default(cuid()); email String @unique; passwordHash String?; name String; phone String?; role Role; status String @default("Active"); lastLoginAt DateTime?; verifiedAt DateTime?; institutionId String?; institution Institution? @relation(fields:[institutionId],references:[id]); student Student?; teacher Teacher?; parent Parent?; notifications Notification[]; sent Message[] @relation("Sent"); received Message[] @relation("Received"); auditLogs AuditLog[]; createdAt DateTime @default(now()); @@index([institutionId,role]) }
model Student { id String @id @default(cuid()); admissionNo String @unique; userId String @unique; user User @relation(fields:[userId],references:[id]); institutionId String; institution Institution @relation(fields:[institutionId],references:[id]); classId String?; class Class? @relation(fields:[classId],references:[id]); parentId String?; parent Parent? @relation(fields:[parentId],references:[id]); status Status @default(ACTIVE); academicYear String @default(""); leavingDate DateTime?; leavingReason String @default(""); graduationDate DateTime?; attendance Attendance[]; fees Fee[]; results Result[]; submissions Submission[]; documents Document[]; @@index([institutionId,classId]) }
model InstitutionSetting { institutionId String @id; institution Institution @relation(fields:[institutionId],references:[id]); academicYear String; schoolAddress String @default(""); schoolPhone String @default(""); schoolEmail String @default(""); diseCode String @default(""); website String @default(""); city String @default(""); state String @default(""); pinCode String @default(""); principalName String @default(""); registrationNumber String @default(""); affiliation String @default(""); motto String @default(""); schoolType String @default(""); feeReceiptTitle String @default("Fee Payment Receipt"); feeReceiptSubheader String @default("Standard Fee Receipt Template"); payslipTitle String @default("Pay Slip"); payslipSubheader String @default("Standard Pay Slip Template"); footerText String @default(""); signatureLabel String @default("Authorized Signatory"); updatedAt DateTime @updatedAt; @@map("settings") }
model AcademicYear { id String @id @default(cuid()); institutionId String; institution Institution @relation(fields:[institutionId],references:[id]); name String; startMonth Int @default(4); endMonth Int @default(3); status String @default("Active"); isActive Boolean @default(false); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([institutionId,name]); @@index([institutionId,status,isActive]); @@map("academic_years") }
model InstitutionClass { id String @id @default(cuid()); institutionId String; institution Institution @relation(fields:[institutionId],references:[id]); name String; sortOrder Int @default(0); status String @default("Active"); sections InstitutionSection[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([institutionId,name]); @@index([institutionId,status,sortOrder]); @@map("institution_classes") }
model InstitutionSection { id String @id @default(cuid()); institutionId String; classId String; schoolClass InstitutionClass @relation(fields:[classId],references:[id]); name String; sortOrder Int @default(0); status String @default("Active"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([classId,name]); @@index([institutionId,classId,status,sortOrder]); @@map("institution_sections") }
model SchoolAsset { id String @id @default(cuid()); institutionId String; institution Institution @relation(fields:[institutionId],references:[id]); kind String; mimeType String; data Bytes; sizeBytes Int; updatedAt DateTime @updatedAt; @@unique([institutionId,kind]); @@map("school_assets") }
model Teacher { id String @id @default(cuid()); employeeNo String @unique; userId String @unique; user User @relation(fields:[userId],references:[id]); institutionId String; institution Institution @relation(fields:[institutionId],references:[id]); subjects Subject[]; documents Document[] }
model Parent { id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId],references:[id]); students Student[] }
model Class { id String @id @default(cuid()); name String; section String; institutionId String; institution Institution @relation(fields:[institutionId],references:[id]); students Student[]; subjects Subject[]; timetable Timetable[]; assignments Assignment[]; @@unique([institutionId,name,section]) }
model Subject { id String @id @default(cuid()); name String; code String; classId String; class Class @relation(fields:[classId],references:[id]); teacherId String?; teacher Teacher? @relation(fields:[teacherId],references:[id]); exams Exam[]; timetable Timetable[] }
model Attendance { id String @id @default(cuid()); date DateTime; status AttendanceStatus; studentId String; student Student @relation(fields:[studentId],references:[id]); markedBy String; @@unique([studentId,date]); @@index([date,status]) }
model Admission { id String @id @default(cuid()); institutionId String; applicantName String; email String; status Status @default(PENDING); data Json; createdAt DateTime @default(now()) }
model Fee { id String @id @default(cuid()); title String; amount Decimal @db.Decimal(12,2); dueDate DateTime; studentId String; student Student @relation(fields:[studentId],references:[id]); institutionId String; institution Institution @relation(fields:[institutionId],references:[id]); payments Payment[] }
model Payment { id String @id @default(cuid()); amount Decimal @db.Decimal(12,2); status PaymentStatus @default(CREATED); method String?; providerOrderId String? @unique; providerPaymentId String? @unique; feeId String?; fee Fee? @relation(fields:[feeId],references:[id]); invoice Invoice?; createdAt DateTime @default(now()) }
model Invoice { id String @id @default(cuid()); number String @unique; paymentId String @unique; payment Payment @relation(fields:[paymentId],references:[id]); tax Decimal @db.Decimal(12,2); issuedAt DateTime @default(now()) }
model Exam { id String @id @default(cuid()); name String; startsAt DateTime; subjectId String; subject Subject @relation(fields:[subjectId],references:[id]); results Result[] }
model Result { id String @id @default(cuid()); marks Decimal @db.Decimal(5,2); grade String; examId String; exam Exam @relation(fields:[examId],references:[id]); studentId String; student Student @relation(fields:[studentId],references:[id]); @@unique([examId,studentId]) }
model Assignment { id String @id @default(cuid()); title String; description String; dueAt DateTime; classId String; class Class @relation(fields:[classId],references:[id]); submissions Submission[] }
model Submission { id String @id @default(cuid()); assignmentId String; assignment Assignment @relation(fields:[assignmentId],references:[id]); studentId String; student Student @relation(fields:[studentId],references:[id]); fileUrl String?; marks Decimal? @db.Decimal(5,2); feedback String?; submittedAt DateTime @default(now()); @@unique([assignmentId,studentId]) }
model Timetable { id String @id @default(cuid()); classId String; class Class @relation(fields:[classId],references:[id]); subjectId String; subject Subject @relation(fields:[subjectId],references:[id]); weekday Int; startsAt String; endsAt String; room String; @@unique([classId,weekday,startsAt]) }
model LibraryBook { id String @id @default(cuid()); title String; author String; isbn String @unique; copies Int; transactions LibraryTransaction[] }
model LibraryTransaction { id String @id @default(cuid()); bookId String; book LibraryBook @relation(fields:[bookId],references:[id]); userId String; issuedAt DateTime @default(now()); dueAt DateTime; returnedAt DateTime?; fine Decimal @default(0) @db.Decimal(10,2) }
model Transport { id String @id @default(cuid()); institutionId String; route String; vehicleNo String; driverName String; stops Json }
model Event { id String @id @default(cuid()); institutionId String; title String; startsAt DateTime; type String; audience Role[] }
model Notice { id String @id @default(cuid()); institutionId String; title String; content String; priority String; audience Role[]; publishedAt DateTime?; expiresAt DateTime? }
model Notification { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id]); type String; title String; readAt DateTime?; createdAt DateTime @default(now()); @@index([userId,readAt]) }
model Message { id String @id @default(cuid()); senderId String; sender User @relation("Sent",fields:[senderId],references:[id]); receiverId String; receiver User @relation("Received",fields:[receiverId],references:[id]); body String; readAt DateTime?; createdAt DateTime @default(now()) }
model SubscriptionPlan { id String @id; name String @unique; price Decimal @db.Decimal(12,2); studentLimit Int; teacherLimit Int @default(0); billingPeriod String @default("year"); active Boolean @default(true); features Json; subscriptions Subscription[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Subscription { id String @id @default(cuid()); institutionId String; institution Institution @relation(fields:[institutionId],references:[id]); planId String; plan SubscriptionPlan @relation(fields:[planId],references:[id]); studentCapacity Int; amountPaid Decimal @default(0) @db.Decimal(12,2); status String; activationDate DateTime?; expiryDate DateTime?; razorpayOrderId String @unique; razorpayPaymentId String? @unique; razorpaySignature String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([institutionId,status,expiryDate]) }
model Document { id String @id @default(cuid()); name String; url String; mimeType String; studentId String?; student Student? @relation(fields:[studentId],references:[id]); teacherId String?; teacher Teacher? @relation(fields:[teacherId],references:[id]); createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()); userId String?; user User? @relation(fields:[userId],references:[id]); institutionId String?; action String; entity String; entityId String?; metadata Json?; ip String?; createdAt DateTime @default(now()); @@index([institutionId,createdAt]) }
model AdminSetting { id String @id; applicationName String @default("EduLedger"); supportEmail String @default(""); currency String @default("INR"); timezone String @default("Asia/Kolkata"); dateFormat String @default("DD/MM/YYYY"); sessionTimeoutMinutes Int @default(10080); updatedBy String?; updatedAt DateTime @updatedAt; @@map("admin_settings") }
